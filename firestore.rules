rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@\\s]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isFirebaseAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.email in ['quanghieun370@gmail.com', 'quanghieu18112013@gmail.com'] ||
        (exists(/databases/$(database)/documents/google_account_links/$(request.auth.uid))
          && get(/databases/$(database)/documents/google_account_links/$(request.auth.uid)).data.linkedRole == 'admin')
      );
    }

    function isAdminUsername(username) {
      return username.matches('^[aA][dD][mM][iI][nN]$');
    }

    function isValidAccountCredential(data) {
      return data.keys().hasAll(['username', 'hash', 'salt'])
        && data.keys().hasOnly(['username', 'hash', 'salt', 'iterations', 'updatedAt'])
        && data.username is string && data.username.size() > 0 && data.username.size() <= 128
        && data.hash is string && data.hash.size() > 0 && data.hash.size() <= 128
        && data.salt is string && data.salt.size() > 0 && data.salt.size() <= 128
        && (!('iterations' in data) || (data.iterations is number && data.iterations >= 10000 && data.iterations <= 1000000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['username', 'displayName', 'role'])
        && data.keys().hasOnly(['username', 'displayName', 'role', 'classId', 'assignedGroup', 'studentId', 'studentName', 'studentSTT', 'updatedAt'])
        && !('password' in data)
        && data.username is string && data.username.size() > 0 && data.username.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 200
        && data.role is string && data.role in ['admin', 'gvcn', 'loptruong', 'loppho', 'to1', 'to2', 'to3', 'to4', 'phhs']
        && (!('classId' in data) || (data.classId is string && data.classId.size() <= 30))
        && (!('assignedGroup' in data) || data.assignedGroup is number)
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 150))
        && (!('studentSTT' in data) || data.studentSTT is number)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUid(uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128 && uid.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGoogleAccountLink(data) {
      return data.keys().hasAll(['uid', 'email', 'linkedUsername', 'linkedRole', 'linkProof', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'linkedUsername', 'linkedRole', 'linkProof', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.linkedUsername is string && data.linkedUsername.size() > 0 && data.linkedUsername.size() <= 128
        && data.linkedRole is string && data.linkedRole in ['admin', 'gvcn', 'loptruong', 'loppho', 'to1', 'to2', 'to3', 'to4', 'phhs']
        && data.linkProof is string && data.linkProof.size() > 0 && data.linkProof.size() <= 256
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidUsernameGoogleLink(data) {
      return data.keys().hasAll(['username', 'uid', 'linkedAt'])
        && data.keys().hasOnly(['username', 'uid', 'linkedAt'])
        && data.username is string && data.username.size() > 0 && data.username.size() <= 128
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.linkedAt is string && data.linkedAt.size() <= 64;
    }

    // 1. Account Credentials Collection (PBKDF2 Password Hashes & Salts)
    // Strictest security:
    // - Listing/scraping is strictly FORBIDDEN.
    // - Unauthenticated or non-admin clients CANNOT create, update, or delete ANY credential document.
    // - Admin credential document CANNOT even be read by non-admin callers.
    match /account_credentials/{username} {
      allow list: if false;
      allow get: if isFirebaseAdmin() || (isValidId(username) && !isAdminUsername(username));
      allow create, update: if isFirebaseAdmin()
        && isValidId(username)
        && isValidAccountCredential(incoming())
        && incoming().username == username;
      allow delete: if false;
    }

    // 2. User Accounts (Public Directory)
    // Plaintext passwords are FORBIDDEN. Only verified Firebase Admin may create/modify accounts.
    match /accounts/{username} {
      allow get: if isValidId(username);
      allow list: if true;
      allow create: if isFirebaseAdmin()
        && isValidId(username)
        && isValidAccount(incoming())
        && incoming().username == username;
      allow update: if isFirebaseAdmin()
        && isValidId(username)
        && isValidAccount(incoming())
        && incoming().username == existing().username;
      allow delete: if false;
    }

    // 3. Students Roster
    match /students/{studentId} {
      allow read: if isValidId(studentId);
      allow list: if true;
      allow create, update: if isValidId(studentId)
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().group is number;
      allow delete: if isValidId(studentId);
    }

    // 4. Point Records (Discipline & Commendation)
    match /point_records/{recordId} {
      allow read: if isValidId(recordId);
      allow list: if true;
      allow create: if isValidId(recordId)
        && incoming().studentId is string
        && incoming().studentName is string
        && incoming().points is number
        && incoming().category is string;
      allow update: if isValidId(recordId)
        && incoming().points is number;
      allow delete: if isValidId(recordId);
    }

    // 5. Scoring Rules Catalog
    match /scoring_rules/{ruleId} {
      allow read: if isValidId(ruleId);
      allow list: if true;
      allow create, update: if isValidId(ruleId)
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300
        && incoming().points is number;
      allow delete: if isValidId(ruleId);
    }

    // 6. School Notifications
    match /notifications/{notifId} {
      allow read: if isValidId(notifId);
      allow list: if true;
      allow create, update: if isValidId(notifId)
        && incoming().title is string && incoming().title.size() <= 300
        && incoming().message is string;
      allow delete: if isValidId(notifId);
    }

    // 7. Score Reports
    match /score_reports/{reportId} {
      allow read: if isValidId(reportId);
      allow list: if true;
      allow create: if isValidId(reportId)
        && incoming().studentName is string
        && incoming().reportedErrorType is string;
      allow update: if isValidId(reportId);
      allow delete: if isValidId(reportId);
    }

    // 8. Feature Suggestions
    match /feature_suggestions/{suggestionId} {
      allow read: if isValidId(suggestionId);
      allow list: if true;
      allow create: if isValidId(suggestionId)
        && incoming().title is string
        && incoming().content is string;
      allow update: if isValidId(suggestionId);
      allow delete: if isValidId(suggestionId);
    }

    // 9. Week Locks
    match /week_locks/{lockId} {
      allow read: if isValidId(lockId);
      allow list: if true;
      allow create, update: if isValidId(lockId)
        && incoming().week is number;
      allow delete: if isValidId(lockId);
    }

    // 10. Parent Document Requirements
    match /parent_doc_configs/{reqId} {
      allow read: if isValidId(reqId);
      allow list: if true;
      allow create, update: if isValidId(reqId)
        && incoming().title is string;
      allow delete: if isValidId(reqId);
    }

    // 11. Parent Submissions
    match /parent_submissions/{subId} {
      allow read: if isValidId(subId);
      allow list: if true;
      allow create, update: if isValidId(subId)
        && incoming().studentName is string
        && incoming().parentName is string;
      allow delete: if isValidId(subId);
    }

    // 12. Student Confessions
    match /student_confessions/{confId} {
      allow read: if isValidId(confId);
      allow list: if true;
      allow create: if isValidId(confId)
        && incoming().title is string
        && incoming().content is string;
      allow update: if isValidId(confId);
      allow delete: if isValidId(confId);
    }

    // 13. System Settings
    match /system_settings/{docId} {
      allow read: if isValidId(docId);
      allow list: if true;
      allow create, update: if isValidId(docId)
        && incoming().schoolName is string;
      allow delete: if false;
    }

    // 14. Supplemental Score Requests (Group Leaders -> Admin / GVCN / Class Monitor)
    match /supplemental_score_requests/{requestId} {
      allow read: if isValidId(requestId);
      allow list: if true;
      allow create: if isValidId(requestId)
        && incoming().classId is string && incoming().classId.size() > 0 && incoming().classId.size() <= 30
        && incoming().week is number && incoming().week >= 1 && incoming().week <= 35
        && incoming().group is number && incoming().group >= 1 && incoming().group <= 4
        && incoming().requesterUsername is string && incoming().requesterUsername.size() > 0 && incoming().requesterUsername.size() <= 100
        && incoming().requesterName is string && incoming().requesterName.size() > 0 && incoming().requesterName.size() <= 150
        && incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 1000
        && incoming().requestedDurationHours is number && incoming().requestedDurationHours > 0 && incoming().requestedDurationHours <= 720
        && incoming().status == 'pending'
        && (!('targetStudentNames' in incoming()) || (incoming().targetStudentNames is string && incoming().targetStudentNames.size() <= 500))
        && (!('proposedDetails' in incoming()) || (incoming().proposedDetails is string && incoming().proposedDetails.size() <= 1000));
      allow update: if isValidId(requestId)
        && incoming().status in ['pending', 'approved', 'rejected']
        && (!('reviewNote' in incoming()) || (incoming().reviewNote is string && incoming().reviewNote.size() <= 1000));
      allow delete: if isValidId(requestId);
    }

    // 15. Google Account Links (UID -> Linked System Account)
    // Strictly owner-only read/write + server-issued HMAC linkProof verified on backend.
    match /google_account_links/{uid} {
      allow list: if false;
      allow get: if isSignedIn() && (request.auth.uid == uid || isFirebaseAdmin());
      allow create: if isVerifiedEmail()
        && request.auth.uid == uid
        && isValidUid(uid)
        && isValidGoogleAccountLink(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email;
      allow update: if isFirebaseAdmin() || (
        isVerifiedEmail()
        && request.auth.uid == uid
        && isValidUid(uid)
        && isValidGoogleAccountLink(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
      );
      allow delete: if isFirebaseAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // 16. Reverse Lock for System Username -> Google UID (Prevents multi-Gmail takeover of 1 account)
    match /username_google_links/{username} {
      allow list: if false;
      allow get: if isSignedIn() && isValidId(username);
      allow create: if isVerifiedEmail()
        && isValidId(username)
        && isValidUsernameGoogleLink(incoming())
        && incoming().username == username
        && incoming().uid == request.auth.uid;
      allow update: if isFirebaseAdmin() || (
        isVerifiedEmail()
        && isValidId(username)
        && isValidUsernameGoogleLink(incoming())
        && incoming().username == existing().username
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
      );
      allow delete: if isFirebaseAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
    }
  }
}
